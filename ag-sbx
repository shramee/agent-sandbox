#!/usr/bin/env bash
# ag-sbx: launch (or attach to) a sandboxed agent container scoped to the
# current directory, with $PWD bind-mounted at the same path inside the
# container. One container per directory, keyed by a hash of its path, so
# running this from different projects doesn't collide or tear down
# previous sandboxes.
set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points at the repo even when ag-sbx is
# invoked through the ~/.local/bin link created by install.sh.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    LINK_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
DIR="$(pwd)"
IMAGE="${AG_SBX_IMAGE:-shramee/agent-sandbox:latest}"
AGENT_HOME="/home/agent"

# One container per directory. Name is sbx-<first 5 of dirname>-<4 hex of path>
# so it's recognisable in `docker ps` but still scoped to this directory.
DIRNAME="$(basename "$DIR")"
DNAME="$(printf '%s' "$DIRNAME" | tr -cd 'A-Za-z0-9_.-' | cut -c1-5 | tr 'A-Z' 'a-z')"
HASH="$(printf '%s' "$DIR" | shasum -a 256 | cut -c1-4)"
CONTAINER_NAME="sbx-${DNAME}-${HASH}"

usage() {
    cat <<EOF
ag-sbx — sandboxed agent container for the current directory

Usage: ag-sbx [command] [-- cmd args...]   (-- prefixed flags work too)

  (none)       Launch or attach to this directory's sandbox container.
  build        Build the image from the repo Dockerfile and recreate this
               directory's container on the fresh build.
  deploy       Build + push the image to Docker Hub, then recreate this
               directory's container on it.
  update       Pull the latest image from Docker Hub and recreate this
               directory's container on it.
  clean        Remove this directory's container so it's recreated fresh.
  help         Show this help.
  dry-run      Print the container name and mount list that would be used,
               without touching docker.
  cmd args…    Run cmd inside the container non-interactively, e.g.
               ag-sbx ls -la   or   ag-sbx zsh
               (attach with no args for the interactive shell)

Env:
  AG_SBX_IMAGE   Image to use instead of shramee/agent-sandbox:latest
EOF
}

BUILD=false
CLEAN=false
DEPLOY=false
UPDATE=false
DRYRUN=false
RUNCMD=()
for arg in "$@"; do
    case "$arg" in
        build|--build) BUILD=true ;;
        clean|--clean) CLEAN=true ;;
        deploy|--deploy) BUILD=true; DEPLOY=true ;;
        update|--update) UPDATE=true ;;
        dry-run|--dry-run) DRYRUN=true ;;
        help|-h|--help) usage; exit 0 ;;
        --)
            # Everything after a bare -- is a command to run in the container.
            RUNCMD=("$@")
            break
            ;;
        *)
            # First unrecognised token: treat the whole remainder as a command
            # to run inside the container (README: "takes an optional command").
            RUNCMD=("$@")
            break
            ;;
    esac
done
# Strip leading subcommand tokens we already consumed off a passthrough cmd.
# e.g. `ag-sbx build -- ls` → ls only. Anything else is left as-is.
if [ "${#RUNCMD[@]}" -gt 0 ]; then
    while [ "${#RUNCMD[@]}" -gt 0 ]; do
        case "${RUNCMD[0]}" in
            build|--build|clean|--clean|deploy|--deploy|update|--update|help|-h|--help|dry-run|--dry-run|--)
                RUNCMD=("${RUNCMD[@]:1}")
                ;;
            *) break ;;
        esac
    done
fi

if $DRYRUN; then
    :  # dry-run doesn't touch docker at all; falls through to print mounts
elif $BUILD; then
    echo "Building $IMAGE"
    docker build -t "$IMAGE" -f "$SCRIPT_DIR/Dockerfile" "$SCRIPT_DIR"
    if $DEPLOY; then
        echo "Pushing $IMAGE to Docker Hub"
        docker push "$IMAGE"
    fi
elif $UPDATE || ! docker image inspect "$IMAGE" &>/dev/null; then
    echo "Pulling $IMAGE"
    docker pull "$IMAGE"
fi

mount() {
    printf -- "type=bind,src=%s,target=%s" "$1" "$2"
}
mount_read() {
    printf -- "type=bind,src=%s,target=%s,readonly" "$1" "$2"
}

# Claude Code on Linux (the container) has no OS keychain, so it reads
# OAuth credentials from ~/.claude/.credentials.json. On macOS those
# credentials live in the Keychain instead. Since ~/.claude is bind-mounted
# into the container, syncing the Keychain secret into that file (on the
# host) makes the login visible inside the sandbox, for new and already
# running containers alike.
sync_claude_credentials() {
    [[ "$(uname)" == "Darwin" ]] || return 0

    local creds_file="$HOME/.claude/.credentials.json"
    local secret
    secret="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null || true)"
    [ -z "$secret" ] && return 0

    umask 077   # never let the token be world-readable, even briefly
    if [ -f "$creds_file" ]; then
        if [ "$(cat "$creds_file" 2>/dev/null)" != "$secret" ]; then
            printf '%s\n' "$secret" >"$creds_file"
            chmod 600 "$creds_file"
        fi
    else
        read -r -p "Save your macOS Claude login into $creds_file so the sandbox can use it? [y/N] " reply
        if [[ "$reply" =~ ^[Yy]$ ]]; then
            printf '%s\n' "$secret" >"$creds_file"
            chmod 600 "$creds_file"
        fi
    fi
}
sync_claude_credentials

# Containers pin their image at creation time, so build/deploy/update must
# also drop the old container or the new image never gets used.
if ! $DRYRUN && { $CLEAN || $BUILD || $UPDATE; } && docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
    echo "Removing container $CONTAINER_NAME for $DIR"
    docker rm -f "$CONTAINER_NAME" >/dev/null
fi

if ! $DRYRUN && docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
    if docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
        echo "Reusing running container $CONTAINER_NAME for $DIR"
    else
        echo "Starting existing container $CONTAINER_NAME for $DIR"
        docker start "$CONTAINER_NAME" >/dev/null
    fi
else
    # Paths the container maps onto the host's ~/.claude / ~/.commandcode.
    # Read-only base mounts expose config/credentials/plugins to the sandbox
    # WITHOUT letting an in-container agent tamper with what the host trusts
    # (settings.json, keybindings, auth tokens). Read-write overlays below
    # keep chat transcripts and session state live between host and sandbox.
    for base in "$HOME/.claude" "$HOME/.commandcode"; do
        [ -d "$base" ] || { echo "error: $base not found — run claude/command-code on the host once (or mkdir -p \"$base\") before using ag-sbx" >&2; exit 1; }
    done

    echo "Creating container $CONTAINER_NAME for $DIR"

    run_args=(
        --mount "$(mount_read "$HOME/.claude" "$AGENT_HOME/.claude")"
        --mount "$(mount_read "$HOME/.commandcode" "$AGENT_HOME/.commandcode")"
    )

    # Live rw overlays: chats + session state must round-trip between host and
    # container (resume / --continue, cross-run messaging), so those dirs stay
    # writeable while everything else above is read-only.
    # Ensure the host source exists (docker won't create it for a bind mount),
    # then add the mount. Dirs and files are handled separately.
    overlay_dir() {  # overlay_dir <host dir> <container dir>
        mkdir -p "$1"
        run_args+=(--mount "$(mount "$1" "$2")")
    }
    overlay_file() {  # overlay_file <host file> <container file>
        mkdir -p "$(dirname "$1")"
        [ -e "$1" ] || : >"$1"
        run_args+=(--mount "$(mount "$1" "$2")")
    }
    overlay_dir "$HOME/.claude/projects"        "$AGENT_HOME/.claude/projects"
    overlay_dir "$HOME/.claude/sessions"        "$AGENT_HOME/.claude/sessions"
    overlay_dir "$HOME/.claude/shell-snapshots" "$AGENT_HOME/.claude/shell-snapshots"
    overlay_dir "$HOME/.commandcode/projects"   "$AGENT_HOME/.commandcode/projects"
    overlay_file "$HOME/.claude/history.jsonl"      "$AGENT_HOME/.claude/history.jsonl"
    overlay_file "$HOME/.commandcode/history.jsonl" "$AGENT_HOME/.commandcode/history.jsonl"
    # Claude Code refreshes its OAuth token by rewriting this file on Linux
    # (no keychain). Keep just it writeable so long sessions don't break on
    # refresh — a single narrow file, not the whole config tree. Only overlay
    # when it actually exists on the host (macOS sync creates it; Linux hosts
    # keep it in ~/.claude); don't manufacture an empty one.
    [ -e "$HOME/.claude/.credentials.json" ] && \
        overlay_file "$HOME/.claude/.credentials.json" "$AGENT_HOME/.claude/.credentials.json"

    # The project dir itself stays live rw too.
    overlay_dir "$DIR" "$DIR"

    [ -f "$HOME/.claude.json" ] && run_args+=(--mount "$(mount_read "$HOME/.claude.json" "$AGENT_HOME/.claude.json")")
    [ -f "$HOME/.gitconfig" ] && run_args+=(--mount "$(mount_read "$HOME/.gitconfig" "$AGENT_HOME/.gitconfig")")

    if $DRYRUN; then
        echo "Image:        $IMAGE"
        echo "Container:    $CONTAINER_NAME"
        echo "Mounts:"
        for ((i = 0; i < ${#run_args[@]}; i += 2)); do
            printf '  %s %s\n' "${run_args[i]}" "${run_args[i + 1]}"
        done
        echo "(dry-run — docker not invoked)"
        exit 0
    fi

    docker run -d --name "$CONTAINER_NAME" "${run_args[@]}" -w "$DIR" "$IMAGE"
fi

# Interactive only when stdin+stdout are a terminal. When stdout is piped
# (e.g. `ag-sbx ... | grep`), skip -t and the banner so we don't emit escape
# noise or prompt through the pipe.
TTY_FLAGS=()
if [ -t 0 ] && [ -t 1 ]; then
    TTY_FLAGS+=(-it)
else
    TTY_FLAGS+=(-i)
fi

# Run a non-interactive command if one was given (no TTY juggling needed).
if [ "${#RUNCMD[@]}" -gt 0 ]; then
    exec docker exec "${TTY_FLAGS[@]}" -w "$DIR" "$CONTAINER_NAME" "${RUNCMD[@]}"
fi

echo "Attaching to $CONTAINER_NAME at $DIR"
SHELL_CMD='zsh'
if [ -t 0 ] && [ -t 1 ]; then
    SHELL_CMD='clear;echo "
┌──────────────────────────────────────────────────┐
│          Welcome to the agent sandbox!           │
│    Some shorthands for all permissions mode      │
├──────────┬───────────────────────────────────────┤
│  cmdy    │ command-code --yolo --no-onboarding   │
│  clauded │ claude --dangerously-skip-permissions │
│  claudem │ claude via Command Code API (gomodel) │
│  exit    │ Return to your host system            │
└──────────────────────────────────────────────────┘
";zsh'
fi
exec docker exec "${TTY_FLAGS[@]}" -w "$DIR" "$CONTAINER_NAME" sh -c "$SHELL_CMD"
