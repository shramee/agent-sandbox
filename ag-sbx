#!/usr/bin/env bash
# ag-sbx: launch (or attach to) a sandboxed agent container scoped to the
# current directory, with $PWD bind-mounted at the same path inside the
# container. One container per directory, keyed by a hash of its path, so
# running this from different projects doesn't collide or tear down
# previous sandboxes.
set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points at the repo even when ag-sbx is
# invoked through the ~/.local/bin link created by install.sh.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    LINK_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
DIR="$(pwd)"
IMAGE="${AG_SBX_IMAGE:-shramee/agent-sandbox:latest}"
AGENT_HOME="/home/agent"

# One container per directory. Name is sbx-<first 5 of dirname>-<4 hex of path>
# so it's recognisable in `docker ps` but still scoped to this directory.
DIRNAME="$(basename "$DIR")"
DNAME="$(printf '%s' "$DIRNAME" | tr -cd 'A-Za-z0-9_.-' | cut -c1-5 | tr 'A-Z' 'a-z')"
HASH="$(printf '%s' "$DIR" | shasum -a 256 | cut -c1-4)"
CONTAINER_NAME="sbx-${DNAME}-${HASH}"
# Per-container staging for writable config copies (seeded from host once,
# never synced back). Dropped on clean/build/update alongside the container.
STAGE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/ag-sbx/$CONTAINER_NAME"
# Per-container opencode dirs. opencode keeps its sessions in a WAL-mode SQLite
# DB, and SQLite locking/shared-memory doesn't work across the Docker Desktop
# bind mount, so sharing the host's ~/.local/share/opencode corrupts it. The
# state dir has to be per-container too: it holds service.json, and a sandbox
# opencode starting its own background service would otherwise overwrite the
# host's. Kept outside STAGE_ROOT so sandbox sessions survive clean/build/update.
OC_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/ag-sbx/$CONTAINER_NAME"
OC_DATA="$OC_ROOT/opencode"
OC_STATE="$OC_ROOT/state/opencode"

usage() {
    cat <<EOF
ag-sbx — sandboxed agent container for the current directory

Usage: ag-sbx [command] [-- cmd args...]   (-- prefixed flags work too)

  (none)       Launch or attach to this directory's sandbox container.
  build        Build the image from the repo Dockerfile and recreate this
               directory's container on the fresh build.
  deploy       Build + push the image to Docker Hub, then recreate this
               directory's container on it.
  update       Pull the latest image from Docker Hub and recreate this
               directory's container on it.
  clean        Remove this directory's container so it's recreated fresh.
  sync         Copy opencode sessions created inside the sandbox into the host
               opencode DB. Also runs automatically when the shell exits.
  help         Show this help.
  dry-run      Print the container name and mount list that would be used,
               without touching docker.
  cmd args…    Run cmd inside the container non-interactively, e.g.
               ag-sbx ls -la   or   ag-sbx zsh
               (attach with no args for the interactive shell)

Env:
  AG_SBX_IMAGE   Image to use instead of shramee/agent-sandbox:latest
EOF
}

BUILD=false
CLEAN=false
DEPLOY=false
UPDATE=false
SYNC=false
DRYRUN=false
RUNCMD=()
for arg in "$@"; do
    case "$arg" in
        build|--build) BUILD=true ;;
        clean|--clean) CLEAN=true ;;
        deploy|--deploy) BUILD=true; DEPLOY=true ;;
        update|--update) UPDATE=true ;;
        sync|--sync) SYNC=true ;;
        dry-run|--dry-run) DRYRUN=true ;;
        help|-h|--help) usage; exit 0 ;;
        --)
            # Everything after a bare -- is a command to run in the container.
            RUNCMD=("$@")
            break
            ;;
        *)
            # First unrecognised token: treat the whole remainder as a command
            # to run inside the container (README: "takes an optional command").
            RUNCMD=("$@")
            break
            ;;
    esac
done
# Strip leading subcommand tokens we already consumed off a passthrough cmd.
# e.g. `ag-sbx build -- ls` → ls only. Anything else is left as-is.
if [ "${#RUNCMD[@]}" -gt 0 ]; then
    while [ "${#RUNCMD[@]}" -gt 0 ]; do
        case "${RUNCMD[0]}" in
            build|--build|clean|--clean|deploy|--deploy|update|--update|sync|--sync|help|-h|--help|dry-run|--dry-run|--)
                RUNCMD=("${RUNCMD[@]:1}")
                ;;
            *) break ;;
        esac
    done
fi

if $DRYRUN; then
    :  # dry-run doesn't touch docker at all; falls through to print mounts
elif $BUILD; then
    echo "Building $IMAGE"
    docker build -t "$IMAGE" -f "$SCRIPT_DIR/Dockerfile" "$SCRIPT_DIR"
    if $DEPLOY; then
        echo "Pushing $IMAGE to Docker Hub"
        docker push "$IMAGE"
    fi
elif $UPDATE || ! docker image inspect "$IMAGE" &>/dev/null; then
    echo "Pulling $IMAGE"
    docker pull "$IMAGE"
fi

mount() {
    printf -- "type=bind,src=%s,target=%s" "$1" "$2"
}
mount_read() {
    printf -- "type=bind,src=%s,target=%s,readonly" "$1" "$2"
}

# Claude Code on Linux (the container) has no OS keychain, so it reads
# OAuth credentials from ~/.claude/.credentials.json. On macOS those
# credentials live in the Keychain instead. Since ~/.claude is bind-mounted
# into the container, syncing the Keychain secret into that file (on the
# host) makes the login visible inside the sandbox, for new and already
# running containers alike.
sync_claude_credentials() {
    [[ "$(uname)" == "Darwin" ]] || return 0

    local creds_file="$HOME/.claude/.credentials.json"
    local secret
    secret="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null || true)"
    [ -z "$secret" ] && return 0

    umask 077   # never let the token be world-readable, even briefly
    if [ -f "$creds_file" ]; then
        if [ "$(cat "$creds_file" 2>/dev/null)" != "$secret" ]; then
            printf '%s\n' "$secret" >"$creds_file"
            chmod 600 "$creds_file"
        fi
    else
        read -r -p "Save your macOS Claude login into $creds_file so the sandbox can use it? [y/N] " reply
        if [[ "$reply" =~ ^[Yy]$ ]]; then
            printf '%s\n' "$secret" >"$creds_file"
            chmod 600 "$creds_file"
        fi
    fi
}
sync_claude_credentials

# Move opencode sessions created inside the sandbox into the host's opencode DB.
# The two DBs stay private — exactly one process writes each, which is what
# keeps them uncorrupted — so sessions are transferred through opencode's
# sanctioned export/import API rather than by sharing the files. Import runs on
# the host, so the host's background service stays the only writer of its DB.
# Session ids already synced are remembered in $OC_ROOT/synced-sessions, which
# makes repeat runs cheap and idempotent (import preserves the session id).
sync_opencode() {
    if $DRYRUN; then return 0; fi
    docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME" || return 0

    # No opencode in the image, or it was never launched in this sandbox.
    docker exec -w "$DIR" "$CONTAINER_NAME" sh -c 'command -v opencode' >/dev/null 2>&1 || return 0

    local ledger="$OC_ROOT/synced-sessions" ids id synced=0
    mkdir -p "$OC_ROOT"
    : >>"$ledger"
    ids="$(docker exec -w "$DIR" "$CONTAINER_NAME" opencode session list 2>/dev/null \
        | awk '$1 ~ /^ses_/ {print $1}')" || return 0
    [ -n "$ids" ] || return 0

    if ! command -v opencode >/dev/null 2>&1; then
        echo "ag-sbx: host opencode not found — skipping session sync" >&2
        return 0
    fi

    for id in $ids; do
        if grep -qx "$id" "$ledger"; then continue; fi
        if docker exec -w "$DIR" "$CONTAINER_NAME" opencode session export "$id" >"$OC_ROOT/$id.json" 2>/dev/null \
            && [ -s "$OC_ROOT/$id.json" ] \
            && opencode session import "$OC_ROOT/$id.json" --directory "$DIR" >/dev/null 2>&1; then
            printf '%s\n' "$id" >>"$ledger"
            synced=$((synced + 1))
        fi
        rm -f "$OC_ROOT/$id.json"
    done
    [ "$synced" -eq 0 ] || echo "Synced $synced opencode session(s) into the host DB"
    return 0
}

# Containers pin their image at creation time, so build/deploy/update must
# also drop the old container or the new image never gets used. Pull any
# sandbox sessions out into the host DB first — the container's own opencode
# data survives, but a stopped container can't be queried for them.
if ! $DRYRUN && { $CLEAN || $BUILD || $UPDATE; } && docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
    sync_opencode
    echo "Removing container $CONTAINER_NAME for $DIR"
    docker rm -f "$CONTAINER_NAME" >/dev/null
fi
if ! $DRYRUN && { $CLEAN || $BUILD || $UPDATE; } && [ -d "$STAGE_ROOT" ]; then
    echo "Removing staged config $STAGE_ROOT"
    rm -rf "$STAGE_ROOT"
fi

# Containers created before OC_DATA/OC_STATE existed mount the host's opencode
# data dir (DB corruption) and/or state dir (the sandbox's service.json
# clobbers the host's); recreate them rather than reattach.
if ! $DRYRUN && docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
    oc_mounts="$(docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' "$CONTAINER_NAME" 2>/dev/null || true)"
    if printf '%s\n' "$oc_mounts" | grep -qx "$HOME/.local/share/opencode" || \
        printf '%s\n' "$oc_mounts" | grep -qx "$HOME/.local/state/opencode"; then
        echo "Recreating $CONTAINER_NAME: it shares the host opencode data/state dir"
        docker rm -f "$CONTAINER_NAME" >/dev/null
    fi
fi

if ! $DRYRUN && docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
    if docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
        echo "Reusing running container $CONTAINER_NAME for $DIR"
    else
        echo "Starting existing container $CONTAINER_NAME for $DIR"
        docker start "$CONTAINER_NAME" >/dev/null
    fi
else
    # Paths the container maps onto the host's ~/.claude / ~/.commandcode.
    # Read-only base mounts expose config/credentials/plugins to the sandbox
    # WITHOUT letting an in-container agent tamper with what the host trusts
    # (settings.json, keybindings, auth tokens). Read-write overlays below
    # keep chat transcripts and session state live between host and sandbox.
    for base in "$HOME/.claude" "$HOME/.commandcode"; do
        [ -d "$base" ] || { echo "error: $base not found — run claude/command-code on the host once (or mkdir -p \"$base\") before using ag-sbx" >&2; exit 1; }
    done

    echo "Creating container $CONTAINER_NAME for $DIR"

    run_args=(
        --mount "$(mount_read "$HOME/.claude" "$AGENT_HOME/.claude")"
        --mount "$(mount_read "$HOME/.commandcode" "$AGENT_HOME/.commandcode")"
    )

    # Live rw overlays: chats + session state must round-trip between host and
    # container (resume / --continue, cross-run messaging), so those dirs stay
    # writeable while everything else above is read-only.
    # Ensure the host source exists (docker won't create it for a bind mount),
    # then add the mount. Dirs and files are handled separately.
    overlay_dir() {  # overlay_dir <host dir> <container dir>
        mkdir -p "$1"
        run_args+=(--mount "$(mount "$1" "$2")")
    }
    overlay_file() {  # overlay_file <host file> <container file>
        mkdir -p "$(dirname "$1")"
        [ -e "$1" ] || : >"$1"
        run_args+=(--mount "$(mount "$1" "$2")")
    }
    # Staged writable copy: seed a per-container copy of a host config file so
    # in-sandbox writes (e.g. /model, /config) succeed without ever reaching
    # the host file the sandbox trusts (hooks, permissions, MCP).
    stage_file() {  # stage_file <host file> <home-relative path>
        mkdir -p "$STAGE_ROOT/$(dirname "$2")"
        chmod 700 "$STAGE_ROOT"
        [ -e "$STAGE_ROOT/$2" ] || { [ -e "$1" ] && cp -p "$1" "$STAGE_ROOT/$2" || : >"$STAGE_ROOT/$2"; }
        run_args+=(--mount "$(mount "$STAGE_ROOT/$2" "$AGENT_HOME/$2")")
    }
    overlay_dir "$HOME/.claude/projects"        "$AGENT_HOME/.claude/projects"
    overlay_dir "$HOME/.claude/sessions"        "$AGENT_HOME/.claude/sessions"
    overlay_dir "$HOME/.claude/shell-snapshots" "$AGENT_HOME/.claude/shell-snapshots"
    overlay_dir "$HOME/.claude/plans"           "$AGENT_HOME/.claude/plans"
    overlay_dir "$HOME/.claude/file-history"    "$AGENT_HOME/.claude/file-history"
    overlay_dir "$HOME/.claude/session-env"     "$AGENT_HOME/.claude/session-env"
    overlay_dir "$HOME/.claude/tasks"           "$AGENT_HOME/.claude/tasks"
    overlay_dir "$HOME/.claude/backups"         "$AGENT_HOME/.claude/backups"
    overlay_dir "$HOME/.commandcode/projects"     "$AGENT_HOME/.commandcode/projects"
    overlay_dir "$HOME/.commandcode/plans"        "$AGENT_HOME/.commandcode/plans"
    overlay_dir "$HOME/.commandcode/file-history" "$AGENT_HOME/.commandcode/file-history"
    # opencode: global config read-only (writable copy staged below). Data
    # (sessions DB, snapshots) and state (service.json, recent-model state) are
    # both per-container — see OC_DATA/OC_STATE. auth.json is seeded from the
    # host on first create so the sandbox starts logged in.
    # Soft-created: opencode may never have run on the host yet.
    mkdir -p "$HOME/.config/opencode" "$OC_DATA" "$OC_STATE"
    chmod 700 "$OC_ROOT"
    [ -e "$OC_DATA/auth.json" ] || { [ -e "$HOME/.local/share/opencode/auth.json" ] && cp -p "$HOME/.local/share/opencode/auth.json" "$OC_DATA/auth.json"; } || true
    run_args+=(--mount "$(mount_read "$HOME/.config/opencode" "$AGENT_HOME/.config/opencode")")
    run_args+=(--mount "$(mount "$OC_DATA"  "$AGENT_HOME/.local/share/opencode")")
    run_args+=(--mount "$(mount "$OC_STATE" "$AGENT_HOME/.local/state/opencode")")
    # opencode-managed plugin install surface stays live so auto-install works.
    [ -d "$HOME/.config/opencode/node_modules" ] && \
        overlay_dir "$HOME/.config/opencode/node_modules" "$AGENT_HOME/.config/opencode/node_modules"
    [ -e "$HOME/.config/opencode/package.json" ] && \
        overlay_file "$HOME/.config/opencode/package.json" "$AGENT_HOME/.config/opencode/package.json"
    [ -e "$HOME/.config/opencode/package-lock.json" ] && \
        overlay_file "$HOME/.config/opencode/package-lock.json" "$AGENT_HOME/.config/opencode/package-lock.json"
    overlay_file "$HOME/.claude/history.jsonl"      "$AGENT_HOME/.claude/history.jsonl"
    overlay_file "$HOME/.commandcode/history.jsonl" "$AGENT_HOME/.commandcode/history.jsonl"
    # Claude Code refreshes its OAuth token by rewriting this file on Linux
    # (no keychain). Keep just it writeable so long sessions don't break on
    # refresh — a single narrow file, not the whole config tree. Only overlay
    # when it actually exists on the host (macOS sync creates it; Linux hosts
    # keep it in ~/.claude); don't manufacture an empty one.
    [ -e "$HOME/.claude/.credentials.json" ] && \
        overlay_file "$HOME/.claude/.credentials.json" "$AGENT_HOME/.claude/.credentials.json"

    # Writable config copies: /model and /config succeed inside the sandbox
    # (container-local only) while the host-trusted originals stay untouched.
    # Model changes in the sandbox don't alter the host default.
    stage_file "$HOME/.claude/settings.json" ".claude/settings.json"
    stage_file "$HOME/.commandcode/config.json" ".commandcode/config.json"
    stage_file "$HOME/.config/opencode/opencode.json" ".config/opencode/opencode.json"

    # The project dir itself stays live rw too.
    overlay_dir "$DIR" "$DIR"

    [ -f "$HOME/.claude.json" ] && stage_file "$HOME/.claude.json" ".claude.json"
    [ -f "$HOME/.gitconfig" ] && run_args+=(--mount "$(mount_read "$HOME/.gitconfig" "$AGENT_HOME/.gitconfig")")

    if $DRYRUN; then
        echo "Image:        $IMAGE"
        echo "Container:    $CONTAINER_NAME"
        echo "Mounts:"
        for ((i = 0; i < ${#run_args[@]}; i += 2)); do
            printf '  %s %s\n' "${run_args[i]}" "${run_args[i + 1]}"
        done
        echo "(dry-run — docker not invoked)"
        exit 0
    fi

    docker run -d --name "$CONTAINER_NAME" "${run_args[@]}" -w "$DIR" "$IMAGE"
fi

# `ag-sbx sync` — pull sandbox sessions into the host DB and stop.
if $SYNC; then
    sync_opencode
    exit 0
fi

# Interactive only when stdin+stdout are a terminal. When stdout is piped
# (e.g. `ag-sbx ... | grep`), skip -t and the banner so we don't emit escape
# noise or prompt through the pipe.
TTY_FLAGS=()
if [ -t 0 ] && [ -t 1 ]; then
    TTY_FLAGS+=(-it)
else
    TTY_FLAGS+=(-i)
fi

# Run a non-interactive command if one was given (no TTY juggling needed).
# No sync here: these are one-shot commands, and the interactive exit below
# (or an explicit `ag-sbx sync`) is where sandbox sessions get pulled across.
if [ "${#RUNCMD[@]}" -gt 0 ]; then
    exec docker exec "${TTY_FLAGS[@]}" -w "$DIR" "$CONTAINER_NAME" "${RUNCMD[@]}"
fi

echo "Attaching to $CONTAINER_NAME at $DIR"
SHELL_CMD='zsh'
if [ -t 0 ] && [ -t 1 ]; then
    SHELL_CMD='clear;echo "
┌──────────────────────────────────────────────────┐
│          Welcome to the agent sandbox!           │
│    Some shorthands for all permissions mode      │
├──────────┬───────────────────────────────────────┤
│  cmdy    │ command-code --yolo --no-onboarding   │
│  clauded │ claude --dangerously-skip-permissions │
│  claudem │ claude via Command Code API (gomodel) │
│  opy     │ opencode --yolo                       │
│  exit    │ Return to your host system            │
└──────────────────────────────────────────────────┘
";zsh'
fi
# Not `exec`: the sandbox shell exiting is the "run finished" moment, so pull
# any opencode sessions created inside into the host DB before returning.
docker exec "${TTY_FLAGS[@]}" -w "$DIR" "$CONTAINER_NAME" sh -c "$SHELL_CMD"
status=$?
sync_opencode
exit "$status"
